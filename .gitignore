# Python Bytecode & Compilation Caches
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyc
*.pyo

# Virtual Environments
.venv/
venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.*
*.pem
*.key
*.cert

# Operating System & IDE Transient Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Test & Coverage Caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Generic Temporary Files
*.tmp
*.temp
*.bak


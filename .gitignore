*.duckdb.tmp
*.duckdb.wal
temp_*.duckdb
test_*.duckdb
scratch/temp_*.duckdb
scratch/temp_*.parquet
data/test_*.duckdb

# Runtime Transient Directories & State
logs/*
!logs/.gitkeep
*.log
scratch/*
!scratch/.gitkeep
runtime/*
